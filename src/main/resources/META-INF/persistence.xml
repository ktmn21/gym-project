<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="gymcrm" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.example.gymcrm.model.User</class>
        <class>com.example.gymcrm.model.Trainee</class>
        <class>com.example.gymcrm.model.Trainer</class>
        <class>com.example.gymcrm.model.Training</class>
        <class>com.example.gymcrm.model.TrainingType</class>

        <properties>
            <!-- DB connection settings -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/gymcrm"/>
            <property name="jakarta.persistence.jdbc.user" value="gym_user"/>
            <property name="jakarta.persistence.jdbc.password" value="gym_pass"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
